<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Antes era blanco: un flash blanco justo antes de que Flutter dibuje
         la app oscura se veia mal. Esto es para Android menor a 12; en 12+
         manda el splash del sistema (ver values-v31/styles.xml). -->
    <item android:drawable="@color/hourtv_splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
